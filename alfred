#!/usr/bin/env bash
# alfred — management script for your personal AI agent

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

ENV_FILE="$SCRIPT_DIR/.env"
PIDS_DIR="$SCRIPT_DIR/.pids"
LOG_DIR="$SCRIPT_DIR/.logs"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${BLUE}[Alfred]${RESET} $*"; }
success() { echo -e "${GREEN}[Alfred]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[Alfred]${RESET} $*"; }
error()   { echo -e "${RED}[Alfred]${RESET} $*" >&2; }

sedi() { sed -i '' "$@" 2>/dev/null || sed -i "$@"; }

check_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    error ".env not found — run:  ./alfred setup"
    exit 1
  fi
  source "$ENV_FILE"
  if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
    error "ANTHROPIC_API_KEY is not set in .env"
    exit 1
  fi
}

is_running() {
  local pid_file="$PIDS_DIR/${1}.pid"
  [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

stop_service() {
  local pid_file="$PIDS_DIR/${1}.pid"
  if is_running "$1"; then
    kill "$(cat "$pid_file")" 2>/dev/null && rm -f "$pid_file"
    success "Stopped $1"
  fi
}

cmd_setup() {
  echo -e "${BOLD}Alfred Setup${RESET}"
  echo "─────────────────────────────"
  mkdir -p "$PIDS_DIR" "$LOG_DIR"
  mkdir -p "$SCRIPT_DIR/wiki/raw" "$SCRIPT_DIR/wiki/sources" \
           "$SCRIPT_DIR/wiki/entities" "$SCRIPT_DIR/wiki/concepts" \
           "$SCRIPT_DIR/wiki/queries"
  success "Wiki directory ready"

  [[ -f "$ENV_FILE" ]] || { cp "$ENV_FILE.example" "$ENV_FILE"; info "Created .env"; }

  if ! command -v node &>/dev/null; then
    error "Node.js not installed — https://nodejs.org (v18+)"; exit 1
  fi
  success "Node $(node --version)"

  npm install --prefix "$SCRIPT_DIR/webchat" --quiet
  npm install --prefix "$SCRIPT_DIR" --quiet
  success "Dependencies installed"

  echo ""
  read -r -p "Anthropic API key (sk-ant-...): " key
  if [[ -n "$key" ]]; then
    sedi "s|ANTHROPIC_API_KEY=.*|ANTHROPIC_API_KEY=$key|" "$ENV_FILE"
  fi

  echo ""
  echo "  Models: claude-opus-4-8  claude-sonnet-4-6  claude-haiku-4-5-20251001"
  read -r -p "Model [claude-sonnet-4-6]: " model
  model="${model:-claude-sonnet-4-6}"
  sedi "s|ANTHROPIC_MODEL=.*|ANTHROPIC_MODEL=$model|" "$ENV_FILE"

  echo ""
  echo "Telegram bot (optional — press Enter to skip)"
  read -r -p "Bot token from @BotFather: " token
  if [[ -n "$token" ]]; then
    sedi "s|TELEGRAM_BOT_TOKEN=.*|TELEGRAM_BOT_TOKEN=$token|" "$ENV_FILE"
    read -r -p "Your Telegram user ID (@userinfobot): " owner
    [[ -n "$owner" ]] && sedi "s|TELEGRAM_OWNER_ID=.*|TELEGRAM_OWNER_ID=$owner|" "$ENV_FILE"
  fi

  echo ""
  success "Setup complete — run:  ./alfred start"
}

cmd_start() {
  check_env
  source "$ENV_FILE"
  mkdir -p "$PIDS_DIR" "$LOG_DIR"

  if is_running "webchat"; then
    warn "Web chat already running (PID $(cat "$PIDS_DIR/webchat.pid"))"
  else
    ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
    ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-claude-sonnet-4-6}" \
    ALFRED_AGENT_NAME="${ALFRED_AGENT_NAME:-Alfred}" \
    ALFRED_WIKI_PATH="$SCRIPT_DIR/wiki" \
      node "$SCRIPT_DIR/webchat/server.js" >> "$LOG_DIR/webchat.log" 2>&1 &
    echo $! > "$PIDS_DIR/webchat.pid"
    success "Alfred started (PID $!)"
  fi

  if [[ -n "${TELEGRAM_BOT_TOKEN:-}" ]] && [[ -f "$SCRIPT_DIR/telegram/bot.js" ]]; then
    if is_running "telegram"; then
      warn "Telegram bot already running"
    else
      TELEGRAM_BOT_TOKEN="$TELEGRAM_BOT_TOKEN" \
      TELEGRAM_OWNER_ID="${TELEGRAM_OWNER_ID:-}" \
      ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
      ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-claude-sonnet-4-6}" \
      ALFRED_WIKI_PATH="$SCRIPT_DIR/wiki" \
        node "$SCRIPT_DIR/telegram/bot.js" >> "$LOG_DIR/telegram.log" 2>&1 &
      echo $! > "$PIDS_DIR/telegram.pid"
      success "Telegram bot started"
    fi
  fi

  echo ""
  echo "  Chat: http://localhost:3000"
  echo "  Logs: ./alfred logs"
  echo "  Stop: ./alfred stop"
  echo ""
}

cmd_stop() {
  stop_service "webchat"
  stop_service "telegram"
}

cmd_restart() { cmd_stop; sleep 1; cmd_start; }

cmd_status() {
  echo ""
  for svc in webchat telegram; do
    if is_running "$svc"; then
      echo -e "  ${GREEN}●${RESET} $svc  (PID $(cat "$PIDS_DIR/${svc}.pid"))"
    else
      echo -e "  ${RED}○${RESET} $svc  (stopped)"
    fi
  done
  echo ""
}

cmd_logs() {
  mkdir -p "$LOG_DIR"
  touch "$LOG_DIR/webchat.log"
  tail -f "$LOG_DIR"/*.log
}

cmd_chat() {
  open "http://localhost:3000" 2>/dev/null \
    || xdg-open "http://localhost:3000" 2>/dev/null \
    || echo "Open http://localhost:3000"
}

cmd_interview() {
  check_env
  source "$ENV_FILE"
  info "Starting profile interview…"
  ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
  ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-claude-sonnet-4-6}" \
  ALFRED_WIKI_PATH="$SCRIPT_DIR/wiki" \
    node "$SCRIPT_DIR/interview/run.js"
}

cmd_schedule() {
  check_env
  source "$ENV_FILE"
  local time="${2:-07:00}"
  local hour="${time%%:*}"
  local minute="${time##*:}"
  local job="$minute $hour * * * ANTHROPIC_API_KEY=\"${ANTHROPIC_API_KEY}\" ANTHROPIC_MODEL=\"${ANTHROPIC_MODEL:-claude-sonnet-4-6}\" ALFRED_WIKI_PATH=\"$SCRIPT_DIR/wiki\" node \"$SCRIPT_DIR/schedule/daily.js\" >> \"$SCRIPT_DIR/.logs/daily.log\" 2>&1"
  # Remove any existing Alfred daily entry then add the new one
  ( crontab -l 2>/dev/null | grep -v "schedule/daily.js"; echo "$job" ) | crontab -
  success "Daily run scheduled at ${time} — logs: ./alfred logs-daily"
}

cmd_unschedule() {
  crontab -l 2>/dev/null | grep -v "schedule/daily.js" | crontab -
  success "Daily schedule removed"
}

cmd_logs_daily() {
  mkdir -p "$LOG_DIR"
  touch "$LOG_DIR/daily.log"
  tail -f "$LOG_DIR/daily.log"
}

case "${1:-help}" in
  setup)       cmd_setup ;;
  start)       cmd_start ;;
  stop)        cmd_stop ;;
  restart)     cmd_restart ;;
  status)      cmd_status ;;
  logs)        cmd_logs ;;
  logs-daily)  cmd_logs_daily ;;
  chat)        cmd_chat ;;
  interview)   cmd_interview ;;
  schedule)    cmd_schedule "$@" ;;
  unschedule)  cmd_unschedule ;;
  *)
    echo ""
    echo -e "${BOLD}Alfred — Personal AI Agent${RESET}"
    echo ""
    echo "  ./alfred setup              First-time setup"
    echo "  ./alfred start              Start Alfred"
    echo "  ./alfred stop               Stop Alfred"
    echo "  ./alfred restart            Restart"
    echo "  ./alfred status             Show service status"
    echo "  ./alfred logs               Tail live logs"
    echo "  ./alfred chat               Open browser"
    echo "  ./alfred interview          Build your profile (wiki/profile.md)"
    echo "  ./alfred schedule [HH:MM]   Schedule daily wiki run (default 07:00)"
    echo "  ./alfred unschedule         Remove daily schedule"
    echo "  ./alfred logs-daily         Tail daily run logs"
    echo ""
    ;;
esac
