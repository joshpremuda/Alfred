#!/usr/bin/env bash
# alfred — management script for your personal AI agent
# Usage: ./alfred [start|stop|restart|status|logs|chat|update|setup]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

ENV_FILE="$SCRIPT_DIR/.env"
COMPOSE="docker compose"

# ─── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${BLUE}[Alfred]${RESET} $*"; }
success() { echo -e "${GREEN}[Alfred]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[Alfred]${RESET} $*"; }
error()   { echo -e "${RED}[Alfred]${RESET} $*" >&2; }

# ─── Helpers ─────────────────────────────────────────────────────────────────
check_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    error ".env file not found. Run:  ./alfred setup"
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$ENV_FILE"

  # Check Ollama is reachable (skip check inside Docker)
  local ollama_host="${OLLAMA_HOST:-http://localhost:11434}"
  if ! curl -sf "${ollama_host}/api/tags" > /dev/null 2>&1; then
    warn "Ollama doesn't appear to be running at ${ollama_host}"
    warn "Start it with: ollama serve  (or open the Ollama app)"
    warn "Then pull a model: ollama pull ${OLLAMA_MODEL:-llama3.2}"
    echo ""
    read -r -p "Continue anyway? [y/N] " cont
    [[ "$cont" =~ ^[Yy]$ ]] || exit 1
  fi
}

# ─── Commands ────────────────────────────────────────────────────────────────
cmd_setup() {
  echo -e "${BOLD}Alfred Setup Wizard${RESET}"
  echo "─────────────────────────────────────────"

  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$SCRIPT_DIR/.env.example" "$ENV_FILE"
    info "Created .env from template"
  fi

  # ── Step 1: Ollama ──
  echo ""
  echo -e "${BOLD}Step 1: Ollama (your free local AI)${RESET}"
  if command -v ollama &>/dev/null; then
    success "Ollama is already installed."
  else
    echo "  Ollama is not installed. Install it now:"
    echo ""
    echo "    macOS:  https://ollama.com/download  (download the app)"
    echo "    Linux:  curl -fsSL https://ollama.com/install.sh | sh"
    echo ""
    echo "  After installing, come back and re-run:  ./alfred setup"
    exit 0
  fi

  echo ""
  echo "  Recommended model: llama3.2 (4GB, fast, great for chat)"
  echo "  Other options:     mistral, qwen2.5, phi3"
  echo ""
  read -r -p "Which model? [llama3.2]: " chosen_model
  chosen_model="${chosen_model:-llama3.2}"
  sed -i "s|OLLAMA_MODEL=.*|OLLAMA_MODEL=$chosen_model|" "$ENV_FILE"

  info "Pulling model '$chosen_model' (may take a few minutes)..."
  ollama pull "$chosen_model"
  success "Model ready."

  # ── Step 2: Telegram (optional) ──
  echo ""
  echo -e "${BOLD}Step 2: Telegram (optional — chat from your phone)${RESET}"
  echo "  1. Message @BotFather on Telegram"
  echo "  2. Send /newbot and follow instructions"
  echo "  3. Paste the token below (or press Enter to skip)"
  read -r -p "Telegram bot token [skip]: " tg_token
  if [[ -n "$tg_token" ]]; then
    sed -i "s|TELEGRAM_BOT_TOKEN=.*|TELEGRAM_BOT_TOKEN=$tg_token|" "$ENV_FILE"
    echo ""
    echo "  To restrict Alfred to yourself only, enter your Telegram user ID."
    echo "  Find it by messaging @userinfobot on Telegram."
    read -r -p "Your Telegram user ID [skip]: " tg_owner
    if [[ -n "$tg_owner" ]]; then
      sed -i "s|OPENCLAW_OWNER_ID=.*|OPENCLAW_OWNER_ID=$tg_owner|" "$ENV_FILE"
    fi
  fi

  echo ""
  success "Setup complete! Start Alfred with:  ./alfred start"
  echo ""
  echo "  Web chat : http://localhost:3000"
  echo "  Model    : $chosen_model (running free via Ollama)"
}

cmd_start() {
  check_env
  info "Starting Alfred..."
  $COMPOSE --env-file "$ENV_FILE" up -d
  echo ""
  success "Alfred is running!"
  echo ""
  echo "  Web chat : http://localhost:3000"
  if grep -q "TELEGRAM_BOT_TOKEN=.\+" "$ENV_FILE" 2>/dev/null; then
    echo "  Telegram : message your bot"
  fi
  echo ""
  echo "  View logs : ./alfred logs"
  echo "  Stop      : ./alfred stop"
}

cmd_stop() {
  info "Stopping Alfred..."
  $COMPOSE down
  success "Alfred stopped."
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_status() {
  $COMPOSE ps
}

cmd_logs() {
  $COMPOSE logs -f --tail=100
}

cmd_chat() {
  info "Opening web chat..."
  xdg-open "http://localhost:3000" 2>/dev/null \
    || open "http://localhost:3000" 2>/dev/null \
    || echo "Open http://localhost:3000 in your browser"
}

cmd_update() {
  info "Pulling latest OpenClaw..."
  $COMPOSE pull 2>/dev/null || true
  $COMPOSE --env-file "$ENV_FILE" up -d --build
  success "Update complete."
}

cmd_onboard() {
  check_env
  info "Running OpenClaw onboarding wizard..."
  $COMPOSE --env-file "$ENV_FILE" run --rm openclaw \
    sh -c "npm install -g openclaw@latest --quiet && openclaw onboard"
}

# ─── Main ────────────────────────────────────────────────────────────────────
case "${1:-help}" in
  setup)    cmd_setup ;;
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  cmd_restart ;;
  status)   cmd_status ;;
  logs)     cmd_logs ;;
  chat)     cmd_chat ;;
  update)   cmd_update ;;
  onboard)  cmd_onboard ;;
  help|*)
    echo ""
    echo -e "${BOLD}Alfred — Personal AI Agent${RESET}"
    echo ""
    echo "  ./alfred setup     First-time setup wizard"
    echo "  ./alfred start     Start Alfred"
    echo "  ./alfred stop      Stop Alfred"
    echo "  ./alfred restart   Restart Alfred"
    echo "  ./alfred status    Show running containers"
    echo "  ./alfred logs      Tail live logs"
    echo "  ./alfred chat      Open web chat in browser"
    echo "  ./alfred update    Pull latest OpenClaw version"
    echo "  ./alfred onboard   Re-run OpenClaw onboarding"
    echo ""
    ;;
esac
