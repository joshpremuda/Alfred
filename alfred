#!/usr/bin/env bash
# alfred — management script for your personal AI agent
# Usage: ./alfred [setup|start|stop|restart|status|logs|chat|update]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

ENV_FILE="$SCRIPT_DIR/.env"
PIDS_DIR="$SCRIPT_DIR/.pids"
LOG_DIR="$SCRIPT_DIR/.logs"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${BLUE}[Alfred]${RESET} $*"; }
success() { echo -e "${GREEN}[Alfred]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[Alfred]${RESET} $*"; }
error()   { echo -e "${RED}[Alfred]${RESET} $*" >&2; }

sedi() { sed -i '' "$@" 2>/dev/null || sed -i "$@"; }

check_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    error ".env not found — run:  ./alfred setup"
    exit 1
  fi
  source "$ENV_FILE"
  local host="${OLLAMA_HOST:-http://localhost:11434}"
  if ! curl -sf --connect-timeout 2 --max-time 3 "${host}/api/tags" > /dev/null 2>&1; then
    warn "Ollama not responding at ${host}"
    warn "Start it with:  ollama serve  (or open the Ollama app)"
    echo ""
    read -r -p "Continue anyway? [y/N] " cont
    [[ "$cont" =~ ^[Yy]$ ]] || exit 1
  fi
}

is_running() {
  local pid_file="$PIDS_DIR/${1}.pid"
  [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

stop_service() {
  local pid_file="$PIDS_DIR/${1}.pid"
  if is_running "$1"; then
    kill "$(cat "$pid_file")" 2>/dev/null && rm -f "$pid_file"
    success "Stopped $1"
  fi
}

cmd_setup() {
  echo -e "${BOLD}Alfred Setup${RESET}"
  echo "─────────────────────────────"
  mkdir -p "$PIDS_DIR" "$LOG_DIR"

  [[ -f "$ENV_FILE" ]] || { cp "$ENV_FILE.example" "$ENV_FILE"; info "Created .env"; }

  # Node
  if ! command -v node &>/dev/null; then
    error "Node.js not installed — https://nodejs.org (v18+)"; exit 1
  fi
  success "Node $(node --version)"

  # Web chat deps
  npm install --prefix "$SCRIPT_DIR/webchat" --quiet
  success "Web chat dependencies installed"

  # Ollama
  if ! command -v ollama &>/dev/null; then
    error "Ollama not installed — https://ollama.com/download"; exit 1
  fi
  success "Ollama found"

  echo ""
  echo "  Recommended models: llama3.2 (4GB)  mistral (4GB)  phi3 (2GB)"
  read -r -p "Which model? [llama3.2]: " model
  model="${model:-llama3.2}"
  sedi "s|OLLAMA_MODEL=.*|OLLAMA_MODEL=$model|" "$ENV_FILE"
  info "Pulling $model…"
  ollama pull "$model"
  success "Model ready"

  # Telegram (optional)
  echo ""
  echo "Telegram bot (optional — press Enter to skip)"
  read -r -p "Bot token from @BotFather: " token
  if [[ -n "$token" ]]; then
    sedi "s|TELEGRAM_BOT_TOKEN=.*|TELEGRAM_BOT_TOKEN=$token|" "$ENV_FILE"
    read -r -p "Your Telegram user ID (@userinfobot): " owner
    [[ -n "$owner" ]] && sedi "s|TELEGRAM_OWNER_ID=.*|TELEGRAM_OWNER_ID=$owner|" "$ENV_FILE"
  fi

  echo ""
  success "Setup complete — run:  ./alfred start"
}

cmd_start() {
  check_env
  source "$ENV_FILE"
  mkdir -p "$PIDS_DIR" "$LOG_DIR"

  if is_running "webchat"; then
    warn "Web chat already running (PID $(cat "$PIDS_DIR/webchat.pid"))"
  else
    OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}" \
    OLLAMA_MODEL="${OLLAMA_MODEL:-llama3.2}" \
    ALFRED_AGENT_NAME="${ALFRED_AGENT_NAME:-Alfred}" \
      node "$SCRIPT_DIR/webchat/server.js" >> "$LOG_DIR/webchat.log" 2>&1 &
    echo $! > "$PIDS_DIR/webchat.pid"
    success "Alfred started (PID $!)"
  fi

  # Telegram bot
  if [[ -n "${TELEGRAM_BOT_TOKEN:-}" ]]; then
    if is_running "telegram"; then
      warn "Telegram bot already running"
    elif [[ -f "$SCRIPT_DIR/telegram/bot.js" ]]; then
      TELEGRAM_BOT_TOKEN="$TELEGRAM_BOT_TOKEN" \
      TELEGRAM_OWNER_ID="${TELEGRAM_OWNER_ID:-}" \
      OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}" \
      OLLAMA_MODEL="${OLLAMA_MODEL:-llama3.2}" \
        node "$SCRIPT_DIR/telegram/bot.js" >> "$LOG_DIR/telegram.log" 2>&1 &
      echo $! > "$PIDS_DIR/telegram.pid"
      success "Telegram bot started"
    fi
  fi

  echo ""
  echo "  Chat: http://localhost:3000"
  echo ""
  echo "  Logs: ./alfred logs"
  echo "  Stop: ./alfred stop"
}

cmd_stop() {
  stop_service "webchat"
  stop_service "telegram"
}

cmd_restart() { cmd_stop; sleep 1; cmd_start; }

cmd_status() {
  echo ""
  for svc in webchat telegram; do
    if is_running "$svc"; then
      echo -e "  ${GREEN}●${RESET} $svc  (PID $(cat "$PIDS_DIR/${svc}.pid"))"
    else
      echo -e "  ${RED}○${RESET} $svc  (stopped)"
    fi
  done
  echo ""
}

cmd_logs() {
  mkdir -p "$LOG_DIR"
  touch "$LOG_DIR/webchat.log"
  tail -f "$LOG_DIR"/*.log
}

cmd_chat() {
  open "http://localhost:3000" 2>/dev/null \
    || xdg-open "http://localhost:3000" 2>/dev/null \
    || echo "Open http://localhost:3000"
}

case "${1:-help}" in
  setup)   cmd_setup ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    cmd_logs ;;
  chat)    cmd_chat ;;
  *)
    echo ""
    echo -e "${BOLD}Alfred — Personal AI Agent${RESET}"
    echo ""
    echo "  ./alfred setup     First-time setup"
    echo "  ./alfred start     Start Alfred"
    echo "  ./alfred stop      Stop Alfred"
    echo "  ./alfred restart   Restart"
    echo "  ./alfred status    Show service status"
    echo "  ./alfred logs      Tail live logs"
    echo "  ./alfred chat      Open browser"
    echo ""
    ;;
esac
