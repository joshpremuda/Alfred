[Unit]
Description=Alfred Personal AI Agent
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/user/Alfred
ExecStart=/usr/bin/docker compose --env-file /home/user/Alfred/.env up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
