# Alfred — Environment Configuration
# Copy to .env:  cp .env.example .env

# Ollama (free, runs locally) — https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Agent name shown in chat
ALFRED_AGENT_NAME=Alfred

# Optional: Telegram bot token (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Optional: your Telegram user ID (@userinfobot) — restricts access to you only
TELEGRAM_OWNER_ID=
