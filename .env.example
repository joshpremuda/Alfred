# Valet — Environment Configuration
# Copy to .env:  cp .env.example .env    (.env is gitignored — never commit it)

# ── Claude API (answers, briefings, drafting) ──────────────────────────────
# Get/rotate a key at https://console.anthropic.com/keys
# NEVER paste your key into chat. Put it here in your LOCAL .env only.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-5

# ── Local embeddings (free, private — indexing never spends Claude tokens) ──
# Requires Ollama running: https://ollama.com/download
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# ── Knowledge vault (your Obsidian vault) ──────────────────────────────────
# Set automatically by: ./scripts/setup-macos.sh vault
BRAIN_VAULT=

# ── App ────────────────────────────────────────────────────────────────────
AGENT_NAME=Alfred
PORT=3210

# ── Optional / future ──────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=
