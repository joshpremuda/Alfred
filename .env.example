# Valet — Environment Configuration
# Copy to .env.local:  cp .env.example .env.local

# ── Anthropic Claude API (required) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Data Storage ────────────────────────────────────────────────────────────
# Path to store SQLite database and uploads (defaults shown)
# DATA_DIR=./data
# UPLOADS_DIR=./uploads

# ── Connectors (add credentials to enable each one) ─────────────────────────

# Instapaper — no API key needed, just your login
# INSTAPAPER_USERNAME=your@email.com
# INSTAPAPER_PASSWORD=yourpassword

# Feedly — get token at feedly.com/i/cortex
# FEEDLY_ACCESS_TOKEN=

# X (Twitter) — get access at developer.twitter.com
# X_BEARER_TOKEN=
# X_USER_ID=

# Pinterest — get token at developers.pinterest.com
# PINTEREST_ACCESS_TOKEN=

# ── Future: Google Calendar ──────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
