# Alfred — Environment Configuration
# Copy to .env:  cp .env.example .env

# ── Option A: Ollama (free, runs locally) — https://ollama.com ─────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Option B: Anthropic Claude (paid) — takes precedence over Ollama ───────
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Agent name shown in chat
ALFRED_AGENT_NAME=Alfred

# Optional: Telegram bot token (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Optional: your Telegram user ID (@userinfobot) — restricts access to you only
TELEGRAM_OWNER_ID=

# ── Notion CRM Integration ──────────────────────────────────────────────────
# Get token: notion.so/profile/integrations → New integration → copy token
NOTION_TOKEN=
# ID of the Notion database to write the Smalley Coffee CRM into
NOTION_CRM_DATABASE_ID=
# ID of the source Notion database to read from (from the shared link)
NOTION_SOURCE_DATABASE_ID=adf1c7f9d8134dd3945aa32ed4d25eab

# ── Google (Gmail + Sheets) Integration ────────────────────────────────────
# Get credentials: console.cloud.google.com → OAuth 2.0 Client IDs → Desktop app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Sheet ID (from the URL between /d/ and /edit)
GOOGLE_SHEET_ID=1oolgnPGky69dKRrNQAyFHBpzMYCve1esjfyw6Zp3Bnw
# Tab name to read from the sheet
GOOGLE_SHEET_TAB=crm
