# ─────────────────────────────────────────────────────────────────────────────
# Alfred / OpenClaw — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# ─────────────────────────────────────────────────────────────────────────────

# Ollama settings (free, runs locally on your Mac)
# Ollama must be installed and running: https://ollama.com
# After installing, pull a model: ollama pull llama3.2
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# OPTIONAL: Telegram bot token (recommended — easiest way to chat)
# Create a bot via @BotFather on Telegram, then paste the token here
TELEGRAM_BOT_TOKEN=

# Agent display name (shown in chat interfaces)
OPENCLAW_AGENT_NAME=Alfred

# Your Telegram user ID (for owner-only access)
# Find it by messaging @userinfobot on Telegram
OPENCLAW_OWNER_ID=

# ─── Upgrading to paid later ──────────────────────────────────────────────────
# When ready, swap Ollama for Anthropic by:
#   1. Commenting out OLLAMA_* lines above
#   2. Uncommenting below and adding your key
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
