# Alfred / Smalley VALET — Environment Configuration
# Copy to .env:  cp .env.example .env

# ── AI Backend ──────────────────────────────────────────────────────────────
# Anthropic (required for VALET — Haiku for routing, Sonnet for drafting)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model overrides (defaults shown)
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-4-6

# Ollama fallback (optional — used if ANTHROPIC_API_KEY is not set)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Agent Identity ───────────────────────────────────────────────────────────
ALFRED_AGENT_NAME=VALET

# ── Telegram ─────────────────────────────────────────────────────────────────
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Your personal Telegram user ID — restricts bot to you only
# Get it: message @userinfobot on Telegram
TELEGRAM_OWNER_ID=REPLACE_ME

# ── Notion ───────────────────────────────────────────────────────────────────
# Integration secret from https://www.notion.so/my-integrations
NOTION_TOKEN=REPLACE_ME

# ID of the Notion page where VALET should create databases
# (the long hex string in the page URL)
NOTION_PAGE_ID=REPLACE_ME

# ── Gmail / Google ───────────────────────────────────────────────────────────
# OAuth2 credentials from Google Cloud Console
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REFRESH_TOKEN=REPLACE_ME

# ── News ─────────────────────────────────────────────────────────────────────
NEWSAPI_KEY=REPLACE_ME

# Comma-separated RSS feed URLs for morning briefing
# e.g. https://sprudge.com/feed,https://dailycoffeenews.com/feed
NEWS_RSS_FEEDS=

# ── Design / Image Generation ─────────────────────────────────────────────────
# From https://fal.ai/dashboard
FAL_API_KEY=REPLACE_ME

# ── Polymarket (Phase 6) ──────────────────────────────────────────────────────
POLYMARKET_API_KEY=

# ── n8n (if using n8n orchestration) ─────────────────────────────────────────
N8N_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
N8N_DOMAIN=valet.yourdomain.com

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Chicago
