# ─────────────────────────────────────────────────────────────────────────────
# Alfred / OpenClaw — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: Your Anthropic API key
# Get one at: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# OPTIONAL: Telegram bot token (recommended — easiest way to chat)
# Create a bot via @BotFather on Telegram, then paste the token here
TELEGRAM_BOT_TOKEN=

# Agent display name (shown in chat interfaces)
OPENCLAW_AGENT_NAME=Alfred

# Your Telegram user ID (for owner-only access)
# Find it by messaging @userinfobot on Telegram
OPENCLAW_OWNER_ID=
