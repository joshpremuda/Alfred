# Valet — Environment Configuration
# Copy to .env:  cp .env.example .env    (.env is gitignored — never commit it)

# ── Claude API (answers, briefings, drafting) ──────────────────────────────
# Get/rotate a key at https://console.anthropic.com/keys
# NEVER paste your key into chat. Put it here in your LOCAL .env only.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-5

# ── Local embeddings (free, private — indexing never spends Claude tokens) ──
# Runs in-process via Transformers.js. No Ollama, no daemon, nothing to install.
# Model weights download once on first use and are cached locally.
EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# ── Local chat fallback (free, offline — used only when Claude is unavailable) ─
# In-process via Transformers.js. Alfred prefers Claude when a working key +
# credits exist, and falls back to this model otherwise. Bump to a larger model
# for better quality (e.g. onnx-community/Qwen2.5-1.5B-Instruct or 3B).
LOCAL_MODEL=onnx-community/Qwen2.5-0.5B-Instruct
LOCAL_MODEL_DTYPE=q4

# ── Knowledge vault (your Obsidian vault) ──────────────────────────────────
# Set automatically by: ./scripts/setup-macos.sh vault
BRAIN_VAULT=

# ── App ────────────────────────────────────────────────────────────────────
AGENT_NAME=Alfred
PORT=3210

# ── Chrome "Briefing" bookmarks (optional) ─────────────────────────────────
# "Brief me" reads a Chrome bookmarks folder (default "Briefing") and builds the
# brief around it. Change the folder name, or point at a specific Bookmarks file.
# BRIEFING_FOLDER=Briefing
# CHROME_BOOKMARKS=/Users/josh/Library/Application Support/Google/Chrome/Default/Bookmarks

# ── Calendar awareness (optional) ──────────────────────────────────────────
# Point Alfred at a published .ics calendar (recommended) or a local export.
# iCloud: Calendar → share a calendar → Public Calendar → copy the webcal/https URL.
# CALENDAR_ICS_URL=https://p??-caldav.icloud.com/published/2/....ics
# CALENDAR_ICS_FILE=/Users/josh/Downloads/calendar.ics

# ── Optional / future ──────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=
