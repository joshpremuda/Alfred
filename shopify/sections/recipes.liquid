{{ 'recipes.css' | asset_url | stylesheet_tag }}

<div class="recipes-page">

  <header class="recipes-header">
    <div class="recipes-wordmark">Smalley Coffee Co.</div>
    <h1 class="recipes-title">{{ section.settings.title }}</h1>
    <p class="recipes-subtitle">{{ section.settings.subtitle }}</p>
  </header>

  <div class="recipes-filter-bar">
    <button class="recipes-filter-btn active" data-filter="all">All</button>
    <button class="recipes-filter-btn" data-filter="sparkling">Sparkling</button>
    <button class="recipes-filter-btn" data-filter="shaken">Shaken</button>
    <button class="recipes-filter-btn" data-filter="coldbrew">Cold Brew</button>
    <button class="recipes-filter-btn" data-filter="espresso">Espresso</button>
    <button class="recipes-filter-btn" data-filter="spirit">Spirit-Forward</button>
    <button class="recipes-filter-btn" data-filter="syrup">House Syrups</button>
    <button class="recipes-filter-btn" data-filter="method">Method</button>
  </div>

  <div class="recipes-main">
    <div class="recipes-grid">
      {% for block in section.blocks %}
        {% assign is_syrup = false %}
        {% if block.settings.category == 'syrup' %}
          {% assign is_syrup = true %}
        {% endif %}
        <div class="recipes-card{% if is_syrup %} recipes-card--component{% endif %}"
             data-category="{{ block.settings.category }}"
             {{ block.shopify_attributes }}>
          <div class="recipes-card-header">
            <h2>{{ block.settings.name }}</h2>
            <span class="recipes-badge">{{ block.settings.badge }}</span>
          </div>
          {% if block.settings.ingredients != blank %}
            <ul class="recipes-ingredients">
              {% assign lines = block.settings.ingredients | newline_to_br | split: '<br />' %}
              {% for line in lines %}
                {% assign trimmed = line | strip %}
                {% if trimmed != blank %}
                  <li>{{ trimmed }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
          {% if block.settings.method != blank %}
            <p class="recipes-method">{{ block.settings.method }}</p>
          {% endif %}
          {% if block.settings.note != blank %}
            <p class="recipes-note">{{ block.settings.note }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

</div>

<script>
  (function () {
    var btns = document.querySelectorAll('.recipes-filter-btn');
    var cards = document.querySelectorAll('.recipes-card');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var filter = btn.getAttribute('data-filter');
        cards.forEach(function (card) {
          if (filter === 'all') {
            card.style.display = '';
          } else {
            var cats = (card.getAttribute('data-category') || '').split(' ');
            card.style.display = cats.indexOf(filter) !== -1 ? '' : 'none';
          }
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Recipe Guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Recipe Guide"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Ideas for your menu — built for wholesale partners. Every recipe is a starting point; adjust ratios and featured coffee to fit your program."
    }
  ],
  "blocks": [
    {
      "type": "recipe",
      "name": "Recipe",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Recipe Name"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "sparkling", "label": "Sparkling" },
            { "value": "shaken",    "label": "Shaken" },
            { "value": "coldbrew",  "label": "Cold Brew" },
            { "value": "espresso",  "label": "Espresso" },
            { "value": "spirit",    "label": "Spirit-Forward" },
            { "value": "syrup",     "label": "House Syrup" },
            { "value": "method",    "label": "Method" }
          ],
          "default": "espresso"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Label",
          "info": "Short label shown on the card (e.g. Sparkling, Espresso, Syrup)"
        },
        {
          "type": "textarea",
          "id": "ingredients",
          "label": "Ingredients",
          "info": "One ingredient per line"
        },
        {
          "type": "textarea",
          "id": "method",
          "label": "Method"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note (optional)",
          "info": "Tip, variation, or extra detail — leave blank to hide"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recipe Guide"
    }
  ]
}
{% endschema %}
