{{ 'recipes.css' | asset_url | stylesheet_tag }}

<div class="recipes-page">

  <header class="recipes-header">
    <div class="recipes-wordmark">Smalley Coffee Co.</div>
    <h1 class="recipes-title">Recipe Guide</h1>
    <p class="recipes-subtitle">Ideas for your menu — built for wholesale partners. Every recipe is a starting point; adjust ratios and featured coffee to fit your program.</p>
  </header>

  <div class="recipes-filter-bar">
    <button class="recipes-filter-btn active" data-filter="all">All</button>
    <button class="recipes-filter-btn" data-filter="sparkling">Sparkling</button>
    <button class="recipes-filter-btn" data-filter="shaken">Shaken</button>
    <button class="recipes-filter-btn" data-filter="coldbrew">Cold Brew</button>
    <button class="recipes-filter-btn" data-filter="espresso">Espresso</button>
    <button class="recipes-filter-btn" data-filter="spirit">Spirit-Forward</button>
    <button class="recipes-filter-btn" data-filter="syrup">House Syrups</button>
    <button class="recipes-filter-btn" data-filter="method">Method</button>
  </div>

  <div class="recipes-main">

    <!-- ── SPARKLING ── -->
    <h3 class="recipes-section-heading">Sparkling &amp; Tonic</h3>
    <div class="recipes-grid">

      <div class="recipes-card" data-category="sparkling">
        <div class="recipes-card-header">
          <h2>Grapefruit Espresso Tonic</h2>
          <span class="recipes-badge">Sparkling</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Tonic water</li>
          <li>Fresh grapefruit juice or zest</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Pull espresso over ice. Top with tonic. Finish with a squeeze of grapefruit and an expressed peel.</p>
      </div>

      <div class="recipes-card" data-category="sparkling">
        <div class="recipes-card-header">
          <h2>Orange Marmalade Espresso Tonic</h2>
          <span class="recipes-badge">Sparkling</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>1 tsp orange marmalade</li>
          <li>Tonic water</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Stir marmalade into the bottom of the glass. Add ice. Pull espresso directly over, then top with tonic. The marmalade melts as you stir.</p>
      </div>

      <div class="recipes-card" data-category="sparkling">
        <div class="recipes-card-header">
          <h2>AeroPress Tonic</h2>
          <span class="recipes-badge">Sparkling</span>
        </div>
        <ul class="recipes-ingredients">
          <li>30g coffee / 85g water (AeroPress concentrate)</li>
          <li>Tonic water</li>
          <li>Orange or clementine peel</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Brew a super-concentrated AeroPress shot. Pour over ice, top with tonic, garnish with citrus peel. Clean, bright, and approachable.</p>
        <p class="recipes-note">Add a splash of gin if it's been one of those days.</p>
      </div>

      <div class="recipes-card" data-category="sparkling">
        <div class="recipes-card-header">
          <h2>Pink Grapefruit Cold Brew Soda</h2>
          <span class="recipes-badge">Sparkling</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Cold brew concentrate (Ethiopian blend preferred)</li>
          <li>House grapefruit syrup</li>
          <li>Topo Chico or sparkling water</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Combine cold brew concentrate with grapefruit syrup over ice. Top with Topo Chico. Ratio to taste — start 1:1:2.</p>
        <p class="recipes-note">Works beautifully with a Pink Lady or bright Ethiopian natural.</p>
      </div>

      <div class="recipes-card" data-category="sparkling">
        <div class="recipes-card-header">
          <h2>Cold Brew Spritz</h2>
          <span class="recipes-badge">Sparkling</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Cold brew reduced as a syrup</li>
          <li>Sparkling water</li>
          <li>Fresh citrus (lemon, orange, or grapefruit)</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Reduce cold brew to a thick syrup concentrate. Use it as you would simple syrup — build over ice with sparkling water and citrus. A clever way to showcase cold brew as an ingredient.</p>
      </div>

      <div class="recipes-card" data-category="sparkling spirit">
        <div class="recipes-card-header">
          <h2>Dark 'n Stormy</h2>
          <span class="recipes-badge">Sparkling</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Iced coffee or cold brew</li>
          <li>Ginger beer</li>
          <li>Fresh lime juice</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Fill glass with ice. Add coffee, squeeze of lime, and float ginger beer on top. Stir gently. Coffee plays the role of dark rum.</p>
      </div>

      <div class="recipes-card" data-category="sparkling">
        <div class="recipes-card-header">
          <h2>Lemon-Ginger Cold Brew</h2>
          <span class="recipes-badge">Sparkling</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Cold brew concentrate</li>
          <li>Fresh lemon juice</li>
          <li>Ginger syrup or fresh ginger</li>
          <li>Sparkling or still water</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Combine cold brew with lemon and ginger over ice. Dilute with water to taste. Bright, clean, and refreshing.</p>
      </div>

    </div>

    <!-- ── SHAKEN ── -->
    <h3 class="recipes-section-heading">Shaken</h3>
    <div class="recipes-grid">

      <div class="recipes-card" data-category="shaken">
        <div class="recipes-card-header">
          <h2>Shakerato</h2>
          <span class="recipes-badge">Shaken</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Simple syrup (to taste)</li>
          <li>Ice (for shaking)</li>
        </ul>
        <p class="recipes-method">Pull espresso directly into a shaker tin packed with ice. Add syrup, seal, and shake hard for 10–15 seconds. Strain into a chilled coupe or rocks glass. The result is a silky, foam-topped iced espresso.</p>
      </div>

      <div class="recipes-card" data-category="shaken">
        <div class="recipes-card-header">
          <h2>Blueberry Brown Sugar Shakerato</h2>
          <span class="recipes-badge">Shaken</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Blueberry syrup</li>
          <li>Brown sugar simple syrup</li>
          <li>Ice (for shaking)</li>
        </ul>
        <p class="recipes-method">Shake espresso over ice with both syrups until frothy. Strain into a glass. The brown sugar rounds out the tartness of the blueberry against the espresso.</p>
      </div>

      <div class="recipes-card" data-category="shaken">
        <div class="recipes-card-header">
          <h2>Espresso Coquet</h2>
          <span class="recipes-badge">Shaken</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Coconut syrup or cream of coconut</li>
          <li>Vanilla syrup</li>
          <li>Fresh citrus juice</li>
          <li>Pinch of cinnamon</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Combine all ingredients in a shaker with ice. Shake until cold and frothy. Strain over fresh ice. Dust cinnamon on top.</p>
      </div>

    </div>

    <!-- ── COLD BREW ── -->
    <h3 class="recipes-section-heading">Cold Brew</h3>
    <div class="recipes-grid">

      <div class="recipes-card" data-category="coldbrew">
        <div class="recipes-card-header">
          <h2>Cold Brew, Neat</h2>
          <span class="recipes-badge">Cold Brew</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Cold brew concentrate</li>
          <li>Still or sparkling water</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Serve cold brew over ice, diluted 1:1 with water. Let the coffee speak. Best with a single-origin or blend worth showing off on its own.</p>
      </div>

      <div class="recipes-card" data-category="coldbrew">
        <div class="recipes-card-header">
          <h2>Cold Brew + Coconut Water</h2>
          <span class="recipes-badge">Cold Brew</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Cold brew concentrate</li>
          <li>Coconut water</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Sub coconut water for still water as the diluent. Naturally sweet and hydrating — great for a lighter, lower-caffeine pour.</p>
      </div>

    </div>

    <!-- ── ESPRESSO ── -->
    <h3 class="recipes-section-heading">Espresso</h3>
    <div class="recipes-grid">

      <div class="recipes-card" data-category="espresso">
        <div class="recipes-card-header">
          <h2>Black Honey Americano</h2>
          <span class="recipes-badge">Espresso</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Hot water</li>
          <li>Black honey (or dark raw honey)</li>
        </ul>
        <p class="recipes-method">Dissolve honey in hot water before pulling espresso over. The bitterness of the espresso balances the dark floral sweetness of black honey.</p>
      </div>

      <div class="recipes-card" data-category="espresso">
        <div class="recipes-card-header">
          <h2>Old Fashioned Espresso</h2>
          <span class="recipes-badge">Espresso</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Orange bitters</li>
          <li>Walnut bitters</li>
          <li>Simple syrup</li>
          <li>Large ice cube</li>
        </ul>
        <p class="recipes-method">Stir espresso with both bitters and simple syrup over ice. Serve over a large cube with an expressed orange peel. Coffee as a cocktail — zero alcohol required.</p>
      </div>

      <div class="recipes-card" data-category="espresso">
        <div class="recipes-card-header">
          <h2>Salted Maple Latte</h2>
          <span class="recipes-badge">Espresso</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Maple syrup</li>
          <li>Flaky sea salt</li>
          <li>Steamed milk</li>
        </ul>
        <p class="recipes-method">Add maple syrup to the cup, pull espresso, steam milk and pour. Finish with a pinch of flaky salt. The salt cuts the sweetness and lifts the espresso.</p>
      </div>

      <div class="recipes-card" data-category="espresso">
        <div class="recipes-card-header">
          <h2>Hot Honey Latte</h2>
          <span class="recipes-badge">Espresso</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Hot honey</li>
          <li>Steamed milk</li>
        </ul>
        <p class="recipes-method">Stir hot honey into espresso, then add steamed milk. The heat from the milk blooms the chili notes in the honey against the coffee.</p>
      </div>

      <div class="recipes-card" data-category="espresso">
        <div class="recipes-card-header">
          <h2>Maple Chai Latte</h2>
          <span class="recipes-badge">Espresso</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Chai concentrate</li>
          <li>Maple syrup</li>
          <li>Steamed milk</li>
        </ul>
        <p class="recipes-method">Combine espresso and chai concentrate in equal parts, sweeten with maple, and add steamed milk. Warming, spiced, and a natural menu addition for fall and winter.</p>
      </div>

      <div class="recipes-card" data-category="espresso">
        <div class="recipes-card-header">
          <h2>Orange Zest Espresso</h2>
          <span class="recipes-badge">Espresso</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Milk + splash of cream</li>
          <li>Vanilla syrup</li>
          <li>Fresh orange zest</li>
          <li>Ground cinnamon</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Build over ice: espresso, vanilla, milk and cream. Microplane orange zest over the top and finish with a dusting of cinnamon.</p>
      </div>

      <div class="recipes-card" data-category="espresso">
        <div class="recipes-card-header">
          <h2>Chocolate Cherry Cortado</h2>
          <span class="recipes-badge">Espresso</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Equal parts steamed milk</li>
          <li>Luxardo cherry</li>
          <li>Chocolate bitters</li>
        </ul>
        <p class="recipes-method">Pull espresso, add a dash of chocolate bitters, pour cortado-style with steamed milk. Drop a Luxardo cherry in the cup. Dessert in a small glass.</p>
      </div>

      <div class="recipes-card" data-category="espresso">
        <div class="recipes-card-header">
          <h2>Mocha with Chocolate Bar</h2>
          <span class="recipes-badge">Espresso</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Good quality chocolate bar (melted or grated)</li>
          <li>Steamed milk</li>
        </ul>
        <p class="recipes-method">Melt or grate real chocolate directly into the cup rather than using sauce. Espresso pulls over the melted chocolate, then add steamed milk. The quality of the chocolate matters — use something you'd eat on its own.</p>
      </div>

    </div>

    <!-- ── SPIRIT-FORWARD ── -->
    <h3 class="recipes-section-heading">Spirit-Forward</h3>
    <div class="recipes-grid">

      <div class="recipes-card" data-category="spirit espresso">
        <div class="recipes-card-header">
          <h2>Mexican Coke Espresso</h2>
          <span class="recipes-badge">Spirit-Forward</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Double espresso</li>
          <li>Mexican Coke (cane sugar)</li>
          <li>Peychaud's bitters</li>
          <li>Ice</li>
        </ul>
        <p class="recipes-method">Pull espresso over ice. Add a few dashes of Peychaud's, then pour Mexican Coke slowly over the back of a spoon to layer. The bitters bridge the coffee and cola.</p>
      </div>

      <div class="recipes-card" data-category="spirit">
        <div class="recipes-card-header">
          <h2>Mint Julep Iced Coffee</h2>
          <span class="recipes-badge">Spirit-Forward</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Strong iced coffee or cold brew</li>
          <li>Vanilla mint syrup</li>
          <li>Cream</li>
          <li>Crushed ice</li>
        </ul>
        <p class="recipes-method">Build over crushed ice with cold coffee, vanilla mint syrup, and a pour of cream. Serve julep-style with a mint sprig.</p>
        <p class="recipes-note">The Depraved: same drink, sweetened with Maker's Mark instead of syrup.</p>
      </div>

    </div>

    <!-- ── HOUSE SYRUPS ── -->
    <h3 class="recipes-section-heading">House Syrups &amp; Components</h3>
    <div class="recipes-grid">

      <div class="recipes-card recipes-card--component" data-category="syrup">
        <div class="recipes-card-header">
          <h2>Root Beer Simple Syrup</h2>
          <span class="recipes-badge">Syrup</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Sassafras or sarsaparilla bark</li>
          <li>Warm spices (clove, allspice, star anise)</li>
          <li>Sugar</li>
          <li>Water</li>
        </ul>
        <p class="recipes-method">Simmer spices in water 15 min. Strain, add equal weight sugar, stir to dissolve. Excellent in iced coffee drinks or as a mixer with sparkling water and cold brew.</p>
      </div>

      <div class="recipes-card recipes-card--component" data-category="syrup">
        <div class="recipes-card-header">
          <h2>Toasted Pecan Simple Syrup</h2>
          <span class="recipes-badge">Syrup</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Raw pecans, toasted</li>
          <li>Sugar</li>
          <li>Water</li>
          <li>Pinch of salt</li>
        </ul>
        <p class="recipes-method">Toast pecans until fragrant. Steep in hot simple syrup 30 min, then strain. Nutty, rich — pairs with espresso drinks, cold brew, or fall lattes.</p>
      </div>

      <div class="recipes-card recipes-card--component" data-category="syrup">
        <div class="recipes-card-header">
          <h2>Pine Simple Syrup</h2>
          <span class="recipes-badge">Syrup</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Fresh pine needles (young tips preferred)</li>
          <li>Sugar</li>
          <li>Water</li>
        </ul>
        <p class="recipes-method">Rinse needles well. Steep in hot 1:1 simple syrup off heat for 20 min. Strain. Resinous and herbal — use sparingly. A few drops transforms a cold brew or americano.</p>
        <p class="recipes-note">Use only pesticide-free pine. Young spring tips have the mildest flavor.</p>
      </div>

      <div class="recipes-card recipes-card--component" data-category="syrup">
        <div class="recipes-card-header">
          <h2>Grapefruit Syrup</h2>
          <span class="recipes-badge">Syrup</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Fresh grapefruit juice and zest</li>
          <li>Sugar</li>
          <li>Water</li>
        </ul>
        <p class="recipes-method">Combine juice, zest, and equal-weight sugar. Warm gently until sugar dissolves — do not boil. Strain. Bright and tart; the base for the Pink Grapefruit Cold Brew Soda.</p>
      </div>

    </div>

    <!-- ── METHOD ── -->
    <h3 class="recipes-section-heading">Method Notes</h3>
    <div class="recipes-grid">

      <div class="recipes-card" data-category="method">
        <div class="recipes-card-header">
          <h2>Mini AeroPress Jams</h2>
          <span class="recipes-badge">Method</span>
        </div>
        <ul class="recipes-ingredients">
          <li>10g coffee</li>
          <li>160g water (off boil)</li>
        </ul>
        <p class="recipes-method">A small, quick AeroPress brew — 10g coffee to 160g water. Makes a gentle, full-flavored cup without the intensity of an espresso. A great "booster" format for sampling single origins at events or on bar.</p>
      </div>

      <div class="recipes-card" data-category="method">
        <div class="recipes-card-header">
          <h2>AeroPress Concentrate (Tonic Base)</h2>
          <span class="recipes-badge">Method</span>
        </div>
        <ul class="recipes-ingredients">
          <li>30g coffee</li>
          <li>85g water (off boil)</li>
        </ul>
        <p class="recipes-method">Brew a high-ratio AeroPress concentrate. Use as a stand-in for espresso in iced drinks — especially tonic builds. Lower acidity and different extraction character than espresso makes it distinctly its own thing.</p>
      </div>

      <div class="recipes-card" data-category="method">
        <div class="recipes-card-header">
          <h2>Coffee Soft Serve</h2>
          <span class="recipes-badge">Method</span>
        </div>
        <ul class="recipes-ingredients">
          <li>Cold brew concentrate</li>
          <li>Whole milk or cream</li>
          <li>Sugar</li>
        </ul>
        <p class="recipes-method">Blend cold brew concentrate into a custard base and churn or freeze-stir into soft serve. Serve in cups or cones. A high-impact menu item for cafes with the equipment — simple ingredients, memorable execution.</p>
      </div>

    </div>

  </div><!-- /.recipes-main -->

</div><!-- /.recipes-page -->

<script>
  (function () {
    var btns = document.querySelectorAll('.recipes-filter-btn');
    var cards = document.querySelectorAll('.recipes-card');

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');

        var filter = btn.getAttribute('data-filter');
        cards.forEach(function (card) {
          if (filter === 'all') {
            card.style.display = '';
          } else {
            var cats = (card.getAttribute('data-category') || '').split(' ');
            card.style.display = cats.indexOf(filter) !== -1 ? '' : 'none';
          }
        });
      });
    });
  })();
</script>
